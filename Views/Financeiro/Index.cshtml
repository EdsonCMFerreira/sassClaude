@model FinanceiroViewModel
@{
    ViewData["Title"] = "Financeiro";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
}
<div class="page-heading">
    <div><span class="eyebrow">Financeiro</span><h1>Resumo de vendas.</h1><p class="muted">Entradas a partir das vendas concluídas, já com desconto aplicado.</p></div>
</div>

<div class="metric-grid">
    <article class="metric-card metric-highlight"><span class="metric-label">Total de entradas</span><strong>@Model.TotalEntradas.ToString("C", ptBr)</strong><span class="metric-caption">vendas concluídas</span></article>
</div>

<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Últimos 6 meses</h2><p class="muted">Só entram no cálculo vendas com status "Concluída".</p></div></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light">
                <tr>
                    <th>Mês</th>
                    <th>Entradas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Meses)
                {
                    <tr>
                        <td>@row.Mes.ToString("MMMM/yyyy", ptBr)</td>
                        <td>@row.Entradas.ToString("C", ptBr)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
