@model FinanceiroViewModel
@{
    ViewData["Title"] = "Financeiro";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
}
<div class="page-heading">
    <div><span class="eyebrow">Financeiro</span><h1>Resumo financeiro.</h1><p class="muted">Entradas realizadas e contas a receber, a partir dos pedidos registrados.</p></div>
</div>

<div class="metric-grid">
    <article class="metric-card metric-highlight"><span class="metric-label">Total recebido</span><strong>@Model.TotalEntradas.ToString("C", ptBr)</strong><span class="metric-caption">vendas concluídas</span></article>
    <article class="metric-card"><span class="metric-label">Em aberto</span><strong>@Model.TotalEmAberto.ToString("C", ptBr)</strong><span class="metric-caption">@Model.QuantidadeEmAberto pedido(s) aguardando pagamento</span></article>
    <article class="metric-card"><span class="metric-label">Vencido</span><strong class="@(Model.TotalVencido > 0 ? "status-negative" : "")">@Model.TotalVencido.ToString("C", ptBr)</strong><span class="metric-caption">precisa de atenção</span></article>
    <article class="metric-card"><span class="metric-label">Vence em 7 dias</span><strong>@Model.TotalVenceEm7Dias.ToString("C", ptBr)</strong><span class="metric-caption">fique de olho</span></article>
</div>

<div class="section-heading" style="margin-bottom:14px;"><div><span class="eyebrow">Lucratividade</span><h2>Lucro realizado</h2><p class="muted">Receita menos o custo de compra dos produtos efetivamente vendidos (pedidos concluídos) — diferente do lucro potencial do catálogo.</p></div></div>
<div class="metric-grid">
    <article class="metric-card"><span class="metric-label">Custo dos produtos vendidos</span><strong>@Model.TotalCusto.ToString("C", ptBr)</strong><span class="metric-caption">valor de compra dos itens vendidos</span></article>
    <article class="metric-card metric-highlight"><span class="metric-label">Lucro bruto</span><strong>@Model.LucroBruto.ToString("C", ptBr)</strong><span class="metric-caption">receita − custo</span></article>
    <article class="metric-card"><span class="metric-label">Margem bruta</span><strong class="@(Model.MargemBrutaPercentual >= 0 ? "status-positive" : "status-negative")">@Model.MargemBrutaPercentual.ToString("0.0")%</strong><span class="metric-caption">lucro bruto / receita</span></article>
</div>

<div class="section-heading" style="margin-bottom:14px;"><div><span class="eyebrow">Fornecedores</span><h2>Contas a pagar</h2><p class="muted">Compras não canceladas que ainda não têm data de pagamento registrada.</p></div></div>
<div class="metric-grid">
    <article class="metric-card metric-highlight"><span class="metric-label">Em aberto</span><strong>@Model.TotalEmAbertoPagar.ToString("C", ptBr)</strong><span class="metric-caption">@Model.QuantidadeEmAbertoPagar compra(s) aguardando pagamento</span></article>
    <article class="metric-card"><span class="metric-label">Vencido</span><strong class="@(Model.TotalVencidoPagar > 0 ? "status-negative" : "")">@Model.TotalVencidoPagar.ToString("C", ptBr)</strong><span class="metric-caption">precisa de atenção</span></article>
    <article class="metric-card"><span class="metric-label">Vence em 7 dias</span><strong>@Model.TotalVenceEm7DiasPagar.ToString("C", ptBr)</strong><span class="metric-caption">fique de olho</span></article>
</div>

<div class="content-grid">
    <section class="surface-card users-card">
        <div class="section-heading">
            <div><h2>Entradas nos últimos 6 meses</h2><p class="muted">Só entram no cálculo vendas com status "Concluída", já com desconto aplicado.</p></div>
            <button type="button" class="button button-outline" id="exportarEntradas">Exportar CSV</button>
        </div>
        <div style="padding:10px 27px 0;"><div style="height:240px;"><canvas id="graficoEntradas"></canvas></div></div>
        <div class="table-wrap">
            <table class="data-table" id="tabelaEntradas">
                <thead class="table-light">
                    <tr>
                        <th>Mês</th>
                        <th>Entradas</th>
                        <th>Custo</th>
                        <th>Lucro bruto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Meses)
                    {
                        <tr>
                            <td>@row.Mes.ToString("MMMM/yyyy", ptBr)</td>
                            <td>@row.Entradas.ToString("C", ptBr)</td>
                            <td>@row.Custo.ToString("C", ptBr)</td>
                            <td>@row.Lucro.ToString("C", ptBr)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    <aside class="surface-card settings-card">
        <div style="align-items:start;display:flex;justify-content:space-between;">
            <div><span class="eyebrow">Formas de pagamento</span><h2>Vendas por forma de pagamento</h2></div>
            @if (Model.VendasPorFormaPagamento.Any())
            {
                <button type="button" class="button button-outline" id="exportarFormaPagamento">Exportar CSV</button>
            }
        </div>
        @if (!Model.VendasPorFormaPagamento.Any())
        {
            <p class="muted">Nenhuma venda concluída ainda.</p>
        }
        else
        {
            <div style="height:200px;"><canvas id="graficoFormaPagamento"></canvas></div>
            <div style="margin-top:14px;" id="tabelaFormaPagamento">
                @foreach (var forma in Model.VendasPorFormaPagamento)
                {
                    <div class="settings-row">
                        <div><h3>@forma.FormaPagamento</h3><p class="muted" style="margin:0;">@forma.Quantidade pedido(s)</p></div>
                        <span class="settings-value">@forma.Total.ToString("C", ptBr)</span>
                    </div>
                }
            </div>
        }
    </aside>
</div>

<div class="surface-card users-card" style="margin-top:18px;">
    <div class="section-heading">
        <div><h2>Contas a receber</h2><p class="muted">Pedidos não cancelados/devolvidos que ainda não têm data de pagamento registrada, do vencimento mais próximo para o mais distante.</p></div>
        <button type="button" class="button button-outline" id="exportarContasReceber">Exportar CSV</button>
    </div>
    <div class="table-wrap">
        <table class="data-table" id="tabelaContasReceber">
            <thead class="table-light">
                <tr>
                    <th>Nº do pedido</th>
                    <th>Cliente</th>
                    <th>Valor</th>
                    <th>Vencimento</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="tabelaContasReceberBody"></tbody>
        </table>
    </div>
    <div class="table-pagination" id="paginacaoContasReceber"></div>
</div>

<div class="surface-card users-card" style="margin-top:18px;">
    <div class="section-heading">
        <div><h2>Contas a pagar</h2><p class="muted">Compras não canceladas que ainda não têm data de pagamento registrada, do vencimento mais próximo para o mais distante.</p></div>
        <button type="button" class="button button-outline" id="exportarContasPagar">Exportar CSV</button>
    </div>
    <div class="table-wrap">
        <table class="data-table" id="tabelaContasPagar">
            <thead class="table-light">
                <tr>
                    <th>Nº da conta</th>
                    <th>Fornecedor</th>
                    <th>Valor</th>
                    <th>Vencimento</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="tabelaContasPagarBody"></tbody>
        </table>
    </div>
    <div class="table-pagination" id="paginacaoContasPagar"></div>
</div>

<div class="surface-card users-card" style="margin-top:18px;">
    <div class="section-heading">
        <div><span class="eyebrow">Projeção</span><h2>Fluxo de caixa consolidado</h2><p class="muted">Entradas previstas (contas a receber) menos saídas previstas (contas a pagar), por mês de vencimento, com saldo acumulado.</p></div>
        <button type="button" class="button button-outline" id="exportarFluxoCaixa">Exportar CSV</button>
    </div>
    <div style="padding:10px 27px 0;"><div style="height:240px;"><canvas id="graficoFluxoCaixa"></canvas></div></div>
    <div class="table-wrap">
        <table class="data-table" id="tabelaFluxoCaixa">
            <thead class="table-light">
                <tr>
                    <th>Mês</th>
                    <th>Entradas previstas</th>
                    <th>Saídas previstas</th>
                    <th>Saldo do mês</th>
                    <th>Saldo acumulado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.FluxoCaixa)
                {
                    <tr>
                        <td>@row.Mes.ToString("MMMM/yyyy", ptBr)</td>
                        <td>@row.EntradasPrevistas.ToString("C", ptBr)</td>
                        <td>@row.SaidasPrevistas.ToString("C", ptBr)</td>
                        <td class="@(row.SaldoMes < 0 ? "status-negative" : "status-positive")">@row.SaldoMes.ToString("C", ptBr)</td>
                        <td class="@(row.SaldoAcumulado < 0 ? "status-negative" : "")">@row.SaldoAcumulado.ToString("C", ptBr)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const tema = getComputedStyle(document.documentElement);
        const cor = nomeVariavel => tema.getPropertyValue(nomeVariavel).trim();

        Chart.defaults.font.family = "'Segoe UI', sans-serif";
        Chart.defaults.color = cor('--muted');
        Chart.defaults.animation.duration = 1300;
        Chart.defaults.animation.easing = 'easeOutQuart';

        const ptBrCurrency = value => Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        const mesesLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meses.Select(m => m.Mes.ToString("MMM/yyyy", ptBr))));
        const mesesValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meses.Select(m => m.Entradas)));
        const mesesLucro = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meses.Select(m => m.Lucro)));

        new Chart(document.getElementById('graficoEntradas'), {
            type: 'bar',
            data: {
                labels: mesesLabels,
                datasets: [
                    {
                        label: 'Receita',
                        data: mesesValores,
                        backgroundColor: cor('--flare'),
                        hoverBackgroundColor: cor('--ember'),
                        borderRadius: 8,
                        maxBarThickness: 32
                    },
                    {
                        label: 'Lucro bruto',
                        data: mesesLucro,
                        backgroundColor: cor('--green'),
                        hoverBackgroundColor: cor('--neutral'),
                        borderRadius: 8,
                        maxBarThickness: 32
                    }
                ]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top', align: 'end' },
                    tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${ptBrCurrency(ctx.parsed.y)}` } }
                },
                scales: {
                    y: { grid: { color: cor('--line') }, ticks: { callback: value => ptBrCurrency(value) } },
                    x: { grid: { display: false } }
                }
            }
        });

        const dadosContasReceber = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContasAReceber.Select(c => new {
            pedidoId = c.PedidoId, numeroPedido = c.NumeroPedido, clienteNome = c.ClienteNome,
            valor = c.Valor, dataVencimento = c.DataVencimento, diasParaVencer = c.DiasParaVencer, situacao = c.Situacao
        })));
        const dadosContasPagar = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContasAPagar.Select(c => new {
            compraId = c.CompraId, numeroCompra = c.NumeroCompra, fornecedorNome = c.FornecedorNome,
            valor = c.Valor, dataVencimento = c.DataVencimento, diasParaVencer = c.DiasParaVencer, situacao = c.Situacao
        })));

        function badgeClasseSituacao(situacao) {
            const classes = {
                'Vencido': 'status-badge--cancelada',
                'Vence em breve': 'status-badge--devolucao',
                'Em dia': 'status-badge--concluida'
            };
            return classes[situacao] || 'status-badge--pendente';
        }

        function diasParaVencerHtml(dias) {
            if (dias === null || dias === undefined) return '';
            if (dias < 0) return `<br><small class="muted">${Math.abs(dias)} dia(s) em atraso</small>`;
            if (dias === 0) return `<br><small class="muted">Vence hoje</small>`;
            return `<br><small class="muted">em ${dias} dia(s)</small>`;
        }

        const CONTAS_POR_PAGINA = 10;
        let paginaContasReceber = 1;
        let paginaContasPagar = 1;

        function renderContasReceber() {
            const corpo = document.getElementById('tabelaContasReceberBody');
            const { itens, totalPaginas, paginaAtual } = filtrarEPaginar(dadosContasReceber, { pagina: paginaContasReceber, porPagina: CONTAS_POR_PAGINA });
            paginaContasReceber = paginaAtual;

            corpo.innerHTML = itens.map(conta => `
                <tr>
                    <td>${conta.numeroPedido}</td>
                    <td>${conta.clienteNome}</td>
                    <td>${formatCurrency(conta.valor)}</td>
                    <td>${conta.dataVencimento ? formatDate(conta.dataVencimento) : '—'}${diasParaVencerHtml(conta.diasParaVencer)}</td>
                    <td><span class="status-badge ${badgeClasseSituacao(conta.situacao)}">${conta.situacao}</span></td>
                    <td><a class="table-action" href="/Pedidos?editar=${conta.pedidoId}">Editar</a></td>
                </tr>
            `).join('') || '<tr><td colspan="6" class="muted">Nenhuma conta em aberto — tudo pago ou não há pedidos ativos.</td></tr>';

            renderPaginacao(document.getElementById('paginacaoContasReceber'), paginaContasReceber, totalPaginas, (novaPagina) => {
                paginaContasReceber = novaPagina;
                renderContasReceber();
            });
        }

        function renderContasPagar() {
            const corpo = document.getElementById('tabelaContasPagarBody');
            const { itens, totalPaginas, paginaAtual } = filtrarEPaginar(dadosContasPagar, { pagina: paginaContasPagar, porPagina: CONTAS_POR_PAGINA });
            paginaContasPagar = paginaAtual;

            corpo.innerHTML = itens.map(conta => `
                <tr>
                    <td>${conta.numeroCompra}</td>
                    <td>${conta.fornecedorNome}</td>
                    <td>${formatCurrency(conta.valor)}</td>
                    <td>${conta.dataVencimento ? formatDate(conta.dataVencimento) : '—'}${diasParaVencerHtml(conta.diasParaVencer)}</td>
                    <td><span class="status-badge ${badgeClasseSituacao(conta.situacao)}">${conta.situacao}</span></td>
                    <td><a class="table-action" href="/Compras?editar=${conta.compraId}">Editar</a></td>
                </tr>
            `).join('') || '<tr><td colspan="6" class="muted">Nenhuma conta em aberto — tudo pago ou não há compras ativas.</td></tr>';

            renderPaginacao(document.getElementById('paginacaoContasPagar'), paginaContasPagar, totalPaginas, (novaPagina) => {
                paginaContasPagar = novaPagina;
                renderContasPagar();
            });
        }

        renderContasReceber();
        renderContasPagar();

        document.getElementById('exportarContasReceber')?.addEventListener('click', () => {
            const cabecalho = ['Nº do pedido', 'Cliente', 'Valor', 'Vencimento', 'Dias', 'Situação'];
            const linhas = dadosContasReceber.map(c => [
                c.numeroPedido, c.clienteNome, formatCurrency(c.valor),
                c.dataVencimento ? formatDate(c.dataVencimento) : '—', c.diasParaVencer, c.situacao
            ]);
            baixarCsv([cabecalho, ...linhas], 'contas-a-receber.csv');
        });
        document.getElementById('exportarContasPagar')?.addEventListener('click', () => {
            const cabecalho = ['Nº da conta', 'Fornecedor', 'Valor', 'Vencimento', 'Dias', 'Situação'];
            const linhas = dadosContasPagar.map(c => [
                c.numeroCompra, c.fornecedorNome, formatCurrency(c.valor),
                c.dataVencimento ? formatDate(c.dataVencimento) : '—', c.diasParaVencer, c.situacao
            ]);
            baixarCsv([cabecalho, ...linhas], 'contas-a-pagar.csv');
        });

        document.getElementById('exportarEntradas')?.addEventListener('click', () => {
            exportarTabelaCsv('#tabelaEntradas', 'entradas-ultimos-6-meses.csv');
        });
        document.getElementById('exportarFluxoCaixa')?.addEventListener('click', () => {
            exportarTabelaCsv('#tabelaFluxoCaixa', 'fluxo-de-caixa.csv');
        });
        document.getElementById('exportarFormaPagamento')?.addEventListener('click', () => {
            const cabecalho = ['Forma de pagamento', 'Pedidos', 'Total'];
            const dadosFormaPagamento = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VendasPorFormaPagamento.Select(f => new {
                formaPagamento = f.FormaPagamento, quantidade = f.Quantidade, total = f.Total
            })));
            const linhas = dadosFormaPagamento.map(f => [f.formaPagamento, f.quantidade, formatCurrency(f.total)]);
            baixarCsv([cabecalho, ...linhas], 'vendas-por-forma-de-pagamento.csv');
        });

        const fluxoCaixaLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FluxoCaixa.Select(f => f.Mes.ToString("MMM/yyyy", ptBr))));
        const fluxoCaixaEntradas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FluxoCaixa.Select(f => f.EntradasPrevistas)));
        const fluxoCaixaSaidas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FluxoCaixa.Select(f => f.SaidasPrevistas)));
        const fluxoCaixaSaldoAcumulado = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FluxoCaixa.Select(f => f.SaldoAcumulado)));

        new Chart(document.getElementById('graficoFluxoCaixa'), {
            data: {
                labels: fluxoCaixaLabels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Entradas previstas',
                        data: fluxoCaixaEntradas,
                        backgroundColor: cor('--green'),
                        borderRadius: 8,
                        maxBarThickness: 32
                    },
                    {
                        type: 'bar',
                        label: 'Saídas previstas',
                        data: fluxoCaixaSaidas,
                        backgroundColor: cor('--coral'),
                        borderRadius: 8,
                        maxBarThickness: 32
                    },
                    {
                        type: 'line',
                        label: 'Saldo acumulado',
                        data: fluxoCaixaSaldoAcumulado,
                        borderColor: cor('--blue'),
                        backgroundColor: cor('--blue'),
                        tension: 0.35,
                        pointRadius: 4,
                        yAxisID: 'y'
                    }
                ]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top', align: 'end' },
                    tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${ptBrCurrency(ctx.parsed.y)}` } }
                },
                scales: {
                    y: { grid: { color: cor('--line') }, ticks: { callback: value => ptBrCurrency(value) } },
                    x: { grid: { display: false } }
                }
            }
        });

        const formaPagamentoCanvas = document.getElementById('graficoFormaPagamento');
        if (formaPagamentoCanvas) {
            const formaPagamentoLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VendasPorFormaPagamento.Select(f => f.FormaPagamento)));
            const formaPagamentoValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VendasPorFormaPagamento.Select(f => f.Total)));
            const paletaFormaPagamento = [cor('--blue'), cor('--flare'), cor('--ember'), cor('--green'), cor('--neutral'), cor('--amber'), cor('--coral')];

            new Chart(formaPagamentoCanvas, {
                type: 'doughnut',
                data: {
                    labels: formaPagamentoLabels,
                    datasets: [{
                        data: formaPagamentoValores,
                        backgroundColor: formaPagamentoLabels.map((_, i) => paletaFormaPagamento[i % paletaFormaPagamento.length]),
                        borderColor: '#fff',
                        borderWidth: 3,
                        hoverOffset: 10
                    }]
                },
                options: {
                    cutout: '62%',
                    maintainAspectRatio: false,
                    animation: { animateRotate: true, animateScale: true },
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ptBrCurrency(ctx.parsed)}` } }
                    }
                }
            });
        }
    </script>
}
