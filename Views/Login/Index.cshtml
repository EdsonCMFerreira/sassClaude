@{
    ViewData["Title"] = "Usuários";
}

<div class="page-heading">
    <div><span class="eyebrow">Administração</span><h1>Usuários do workspace.</h1><p class="muted">Gerencie quem pode acessar este espaço.</p></div>
</div>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Contas cadastradas</h2><p class="muted">Credenciais sempre protegidas.</p></div><span class="secure-badge">● Seguro</span></div>
    <div class="user-form-wrap">
        <form id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="loginId" />
                        <div class="user-form-grid">
                            <div><label for="username">Usuário</label><input id="username" required /></div>
                            <div><label for="email">E-mail</label><input id="email" type="email" required /></div>
                            <div><label for="password">Senha</label><input id="password" type="password" /><small>Obrigatória ao criar. Em branco ao editar mantém a atual.</small></div>
                            <div class="user-form-actions"><button type="submit" class="button button-primary">Salvar</button><button type="button" id="cancelEdit" class="button button-outline hidden">Cancelar</button></div>
                        </div>
        </form>
    </div>

    <div class="table-wrap">
                <table class="data-table">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Usuário</th>
                            <th>E-mail</th>
                            <th>Data</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="loginTableBody"></tbody>
                </table>
            </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('loginForm');
        const loginId = document.getElementById('loginId');
        const username = document.getElementById('username');
        const email = document.getElementById('email');
        const password = document.getElementById('password');
        const cancelEdit = document.getElementById('cancelEdit');
        const tableBody = document.getElementById('loginTableBody');
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        async function loadLogins() {
            const response = await fetch('/api/login');
            if (!response.ok) {
                throw new Error('Erro ao carregar usuários.');
            }

            const data = await response.json();
            tableBody.innerHTML = data.map(item => `
                <tr>
                    <td>${item.id}</td>
                    <td>${item.username}</td>
                    <td>${item.email}</td>
                    <td>${new Date(item.createdAt).toLocaleString('pt-BR')}</td>
                    <td>
                        <button class="table-action" data-edit="${item.id}">Editar</button>
                        <button class="table-action danger" data-delete="${item.id}">Excluir</button>
                    </td>
                </tr>
            `).join('');

            tableBody.querySelectorAll('[data-edit]').forEach(button => {
                button.addEventListener('click', () => editLogin(Number(button.dataset.edit)));
            });

            tableBody.querySelectorAll('[data-delete]').forEach(button => {
                button.addEventListener('click', () => deleteLogin(Number(button.dataset.delete)));
            });
        }

        async function editLogin(id) {
            const response = await fetch(`/api/login/${id}`);
            const data = await response.json();
            loginId.value = data.id;
            username.value = data.username;
            email.value = data.email;
            password.value = '';
            cancelEdit.classList.remove('hidden');
            username.focus();
        }

        async function deleteLogin(id) {
            const confirmed = confirm('Deseja excluir este usuário?');
            if (!confirmed) return;

            const response = await fetch(`/api/login/${id}`, { method: 'DELETE', headers: { 'X-CSRF-TOKEN': csrfToken } });
            if (response.ok) {
                await loadLogins();
            }
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const payload = {
                id: Number(loginId.value || 0),
                username: username.value.trim(),
                email: email.value.trim(),
                password: password.value.trim()
            };

            const method = payload.id ? 'PUT' : 'POST';
            const url = payload.id ? `/api/login/${payload.id}` : '/api/login';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                form.reset();
                loginId.value = '';
                cancelEdit.classList.add('hidden');
                await loadLogins();
            } else {
                const errorText = await response.text();
                alert(errorText || 'Erro ao salvar usuário.');
            }
        });

        cancelEdit.addEventListener('click', () => {
            form.reset();
            loginId.value = '';
            cancelEdit.classList.add('hidden');
        });

        loadLogins().catch(error => console.error(error));
    </script>
}
