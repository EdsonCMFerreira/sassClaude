@model SettingsPageViewModel
@{
    ViewData["Title"] = "Configurações";
}
<div class="page-heading"><div><span class="eyebrow">Configurações</span><h1>Preferências do workspace.</h1><p class="muted">Ajuste a experiência do seu espaço de trabalho.</p></div></div>
<div class="settings-layout">
    <div class="settings-stack">
        @if (TempData["SettingsMessage"] is string message)
        {
            <div class="settings-success">@message</div>
        }
        <section class="surface-card settings-card">
            <div class="section-heading"><div><h2>Perfil</h2><p class="muted">Nome de usuário e e-mail da conta.</p></div></div>
            <form asp-controller="Settings" asp-action="UpdateProfile" method="post" class="settings-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="field-row"><label asp-for="Profile.Username"></label><input asp-for="Profile.Username" /><span asp-validation-for="Profile.Username" class="field-error"></span></div>
                <div class="field-row"><label asp-for="Profile.Email"></label><input asp-for="Profile.Email" /><span asp-validation-for="Profile.Email" class="field-error"></span></div>
                <div class="settings-actions"><button class="button button-primary" type="submit">Salvar perfil</button></div>
            </form>
        </section>
        <section class="surface-card settings-card">
            <div class="section-heading"><div><h2>Segurança</h2><p class="muted">Altere sua senha de acesso.</p></div></div>
            <form asp-controller="Settings" asp-action="ChangePassword" method="post" class="settings-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="field-row"><label asp-for="Password.CurrentPassword"></label><input asp-for="Password.CurrentPassword" autocomplete="current-password" /><span asp-validation-for="Password.CurrentPassword" class="field-error"></span></div>
                <div class="field-row"><label asp-for="Password.NewPassword"></label><input asp-for="Password.NewPassword" autocomplete="new-password" /><span asp-validation-for="Password.NewPassword" class="field-error"></span></div>
                <div class="field-row"><label asp-for="Password.ConfirmNewPassword"></label><input asp-for="Password.ConfirmNewPassword" autocomplete="new-password" /><span asp-validation-for="Password.ConfirmNewPassword" class="field-error"></span></div>
                <div class="settings-actions"><button class="button button-primary" type="submit">Atualizar senha</button></div>
            </form>
        </section>
        <section class="surface-card settings-card">
            <div class="settings-row">
                <div><h3>Verificação de e-mail</h3><p>Confirme seu e-mail para garantir o acesso à conta.</p></div>
                @if (Model.EmailConfirmed)
                {
                    <span class="settings-value status-positive">✓ Confirmado</span>
                }
                else
                {
                    <form asp-controller="Settings" asp-action="ResendConfirmation" method="post">
                        @Html.AntiForgeryToken()
                        <button class="table-action" type="submit">Reenviar confirmação</button>
                    </form>
                }
            </div>
            <div class="settings-row"><div><h3>Idioma</h3><p>Idioma padrão da interface.</p></div><span class="settings-value">Português (Brasil)</span></div>
            <div class="settings-row"><div><h3>Notificações</h3><p>Receba novidades sobre seu workspace.</p></div><label class="switch"><input type="checkbox" checked /><span></span></label></div>
        </section>
    </div>
    <aside class="surface-card settings-help"><span class="eyebrow">Precisa de ajuda?</span><h2>Estamos por perto.</h2><p>Se algo não estiver como esperado, fale com o suporte.</p><a class="text-link" href="mailto:suporte@sassclaude.com">Enviar mensagem <span>↗</span></a></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
