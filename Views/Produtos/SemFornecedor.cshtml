@{
    ViewData["Title"] = "Produtos sem fornecedor";
}

<div class="page-heading">
    <div><span class="eyebrow">Catálogo</span><h1>Produtos sem fornecedor.</h1><p class="muted">Produtos cadastrados sem um fornecedor vinculado.</p></div>
    <div class="hero-actions"><a class="button button-outline" style="color:var(--blue);" asp-controller="Produtos" asp-action="Index">← Ver todos os produtos</a></div>
</div>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Sem fornecedor</h2><p class="muted">Clique em "Editar" para vincular um fornecedor na tela de Produtos.</p></div></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th>Validade</th>
                    <th>Quantidade</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="produtoTableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const tableBody = document.getElementById('produtoTableBody');

        function formatDate(value) {
            return new Date(value).toLocaleDateString('pt-BR', { timeZone: 'UTC' });
        }

        async function loadProdutosSemFornecedor() {
            const response = await fetch('/api/produtos');
            if (!response.ok) {
                throw new Error('Erro ao carregar produtos.');
            }

            const data = await response.json();
            const semFornecedor = data
                .filter(item => !item.fornecedorId)
                .sort((a, b) => a.descricao.localeCompare(b.descricao, 'pt-BR'));

            tableBody.innerHTML = semFornecedor.map(item => `
                <tr>
                    <td>${item.codigo}</td>
                    <td>${item.descricao}</td>
                    <td>${formatDate(item.validade)}</td>
                    <td>${item.quantidade}</td>
                    <td><a class="table-action" href="/Produtos?editar=${item.id}">Editar</a></td>
                </tr>
            `).join('') || '<tr><td colspan="5" class="muted">Todos os produtos têm um fornecedor vinculado.</td></tr>';
        }

        loadProdutosSemFornecedor().catch(error => console.error(error));
    </script>
}
