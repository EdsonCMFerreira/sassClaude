@model ProdutoDashboardViewModel
@{
    ViewData["Title"] = "Dashboard de produtos";
}
<div class="page-heading">
    <div><span class="eyebrow">Catálogo</span><h1>Dashboard de produtos.</h1><p class="muted">Visão geral do catálogo, vencimentos e margens.</p></div>
    <div class="hero-actions">
        <a class="button button-outline" style="color:var(--blue);" asp-controller="Produtos" asp-action="Index">← Ver produtos</a>
        <a class="button button-outline" style="color:var(--blue);" asp-controller="Produtos" asp-action="Vencidos">Ver vencidos <span>→</span></a>
        <a class="button button-outline" style="color:var(--blue);" asp-controller="Produtos" asp-action="VencendoEm30Dias">Vencendo em 30 dias <span>→</span></a>
        <a class="button button-outline" style="color:var(--blue);" asp-controller="Produtos" asp-action="SaldoZero">Ver saldo 0 <span>→</span></a>
    </div>
</div>

<div class="metric-grid">
    <article class="metric-card metric-highlight"><span class="metric-label">Produtos cadastrados</span><strong>@Model.TotalProdutos</strong><span class="metric-caption">no catálogo</span></article>
    <article class="metric-card"><span class="metric-label">Vencendo em 30 dias</span><strong>@Model.VenceEm30Dias</strong><span class="metric-caption">fique de olho</span></article>
    <article class="metric-card"><span class="metric-label">Vencidos</span><strong class="@(Model.Vencidos > 0 ? "status-negative" : "")">@Model.Vencidos</strong><span class="metric-caption">precisam de atenção</span></article>
    <article class="metric-card"><span class="metric-label">Lucro médio</span><strong>@Model.LucroMedioPercentual.ToString("0.00")%</strong><span class="metric-caption">entre compra e venda</span></article>
</div>

<div class="content-grid">
    <section class="surface-card activity-card">
        <div class="section-heading"><div><span class="eyebrow">Atenção</span><h2>Próximos vencimentos</h2></div></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead class="table-light"><tr><th>Código</th><th>Descrição</th><th>Validade</th><th>Dias restantes</th></tr></thead>
                <tbody>
                    @if (!Model.ProximosVencimentos.Any())
                    {
                        <tr><td colspan="4" class="muted">Nenhum produto com validade futura cadastrada.</td></tr>
                    }
                    @foreach (var item in Model.ProximosVencimentos)
                    {
                        <tr>
                            <td>@item.Codigo</td>
                            <td>@item.Descricao</td>
                            <td>@item.Validade.ToString("dd/MM/yyyy")</td>
                            <td>@item.DiasRestantes dia(s)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    <aside class="settings-stack">
        <div class="surface-card next-card">
            <span class="eyebrow">Financeiro</span>
            <h2>Resumo do catálogo</h2>
            <div class="settings-row"><div><h3>Valor total de compra</h3></div><span class="settings-value">@Model.ValorTotalCompra.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span></div>
            <div class="settings-row"><div><h3>Valor total de venda</h3></div><span class="settings-value">@Model.ValorTotalVenda.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span></div>
            <div class="settings-row"><div><h3>Lucro potencial</h3></div><span class="settings-value">@Model.LucroPotencialTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span></div>
        </div>
        <div class="surface-card settings-card">
            <span class="eyebrow">Fornecedores</span>
            <h2>Top fornecedores</h2>
            @if (!Model.TopFornecedores.Any())
            {
                <p class="muted">Nenhum fornecedor cadastrado ainda.</p>
            }
            @foreach (var fornecedor in Model.TopFornecedores)
            {
                <div class="settings-row"><div><h3>@fornecedor.Fornecedor</h3></div><span class="settings-value">@fornecedor.Quantidade produto(s)</span></div>
            }
        </div>
        @if (Model.ProdutoMaisLucrativo is not null)
        {
            <div class="surface-card settings-card">
                <span class="eyebrow">Margem</span>
                <h2>Destaques</h2>
                <div class="settings-row"><div><h3>Maior margem</h3><p>@Model.ProdutoMaisLucrativo</p></div><span class="status-positive">@Model.ProdutoMaisLucrativoPercentual?.ToString("0.00")%</span></div>
                <div class="settings-row"><div><h3>Menor margem</h3><p>@Model.ProdutoMenosLucrativo</p></div><span class="settings-value">@Model.ProdutoMenosLucrativoPercentual?.ToString("0.00")%</span></div>
            </div>
        }
    </aside>
</div>

@if (Model.ProdutosPorLucro.Any())
{
    <div class="surface-card activity-card" style="margin-top:18px;">
        <div class="section-heading"><div><span class="eyebrow">Margem</span><h2>Produtos que mais dão lucro</h2><p class="muted">Percentual de lucro entre valor de compra e valor de venda.</p></div></div>
        <div style="height:@(Math.Max(220, Model.ProdutosPorLucro.Count * 36))px;"><canvas id="graficoLucro"></canvas></div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const lucroCanvas = document.getElementById('graficoLucro');
        if (lucroCanvas) {
            const lucroLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProdutosPorLucro.Select(p => p.ProdutoNome)));
            const lucroValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProdutosPorLucro.Select(p => p.PercentualLucro)));

            new Chart(lucroCanvas, {
                type: 'bar',
                data: {
                    labels: lucroLabels,
                    datasets: [{
                        label: '% de lucro',
                        data: lucroValores,
                        backgroundColor: '#218351',
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => `${ctx.parsed.x.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%` } }
                    },
                    scales: {
                        x: { ticks: { callback: value => `${value}%` } }
                    }
                }
            });
        }
    </script>
}
