@model BillingViewModel
@{
    ViewData["Title"] = "Plano e cobrança";
}
<div class="page-heading"><div><span class="eyebrow">Plano e cobrança</span><h1>Escolha o ritmo do seu negócio.</h1><p class="muted">Gerencie seu plano e acompanhe o uso do workspace.</p></div></div>
<section class="billing-layout">
    <article class="plan-card @(Model.Plano == "Starter" ? "plan-current" : "")">
        <span class="eyebrow">Plano atual</span><h2>Starter</h2><div class="plan-price">R$ 0 <small>/ mês</small></div><p>Para começar a organizar sua operação com o essencial.</p><ul><li>Workspace compartilhado</li><li>Cadastro de usuários</li><li>Suporte por e-mail</li></ul>
        @if (Model.Plano == "Starter")
        {
            <button class="button button-outline" type="button" disabled>Plano atual</button>
        }
    </article>
    <article class="plan-card @(Model.Plano == "Pro" ? "plan-current" : "")">
        <span class="eyebrow">Para times em crescimento</span><h2>Pro</h2><div class="plan-price">Em breve</div><p>Mais automação, relatórios e controle para o seu time.</p><ul><li>Projetos ilimitados</li><li>Relatórios avançados</li><li>Permissões personalizadas</li></ul>
        @if (Model.Plano == "Pro")
        {
            <button class="button button-outline" type="button" disabled>Plano atual</button>
        }
        else
        {
            <button class="button button-primary" type="button" onclick="alert('O plano Pro estará disponível em breve.')">Conhecer plano</button>
        }
    </article>
</section>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Histórico de faturas</h2><p class="muted">Cobranças da sua empresa aparecem aqui assim que ela assinar um plano pago.</p></div></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light"><tr><th>Data</th><th>Descrição</th><th>Valor</th><th>Status</th></tr></thead>
            <tbody>
                @if (!Model.Invoices.Any())
                {
                    <tr><td colspan="4" class="muted">Nenhuma fatura ainda — sua empresa está no plano gratuito.</td></tr>
                }
                @foreach (var invoice in Model.Invoices)
                {
                    <tr>
                        <td>@invoice.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@invoice.Description</td>
                        <td>@invoice.Amount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                        <td>@invoice.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
