@model ContactMessageViewModel
@{
    ViewData["Title"] = "Sobre e contato";
    Layout = "_MarketingLayout";
}
<section class="legal-content">
    <span class="eyebrow">Sobre</span>
    <h1>Feito para times que fazem acontecer.</h1>
    <p class="muted">O Saas nasceu para simplificar como pequenos times organizam usuários, projetos e cobrança — tudo em um único workspace, sem complicação.</p>
</section>
<div class="settings-layout">
    <section class="surface-card settings-card">
        <div class="section-heading"><div><h2>Fale com a gente</h2><p class="muted">Dúvidas, sugestões ou problemas? Envie uma mensagem.</p></div></div>
        @if (TempData["ContactSent"] is true)
        {
            <div class="settings-success">Mensagem enviada! Vamos responder no e-mail informado.</div>
        }
        <form asp-controller="Home" asp-action="Contact" method="post" class="settings-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="field-row"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span></div>
            <div class="field-row"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="field-error"></span></div>
            <div class="field-row"><label asp-for="Message"></label><textarea asp-for="Message" rows="5"></textarea><span asp-validation-for="Message" class="field-error"></span></div>
            <div class="settings-actions"><button class="button button-primary" type="submit">Enviar mensagem</button></div>
        </form>
    </section>
    <aside class="surface-card settings-help"><span class="eyebrow">Outro caminho</span><h2>Prefere e-mail direto?</h2><p>Escreva para <a class="text-link" href="mailto:suporte@saas.com">suporte@saas.com</a> ou confira nossa <a class="text-link" asp-controller="Home" asp-action="Help">central de ajuda</a>.</p></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
