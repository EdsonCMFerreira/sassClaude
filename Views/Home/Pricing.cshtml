@{
    ViewData["Title"] = "Preços";
    Layout = "_MarketingLayout";
}
<section class="pricing-hero"><span class="eyebrow">Preços</span><h1>Um plano para cada momento do seu negócio.</h1><p class="muted">Comece de graça e evolua quando precisar de mais.</p></section>
<section class="pricing-grid">
    <article class="plan-card plan-current"><span class="eyebrow">Para começar</span><h2>Starter</h2><div class="plan-price">R$ 0 <small>/ mês</small></div><p>Para organizar sua operação com o essencial.</p><ul><li>Workspace compartilhado</li><li>Cadastro de usuários</li><li>Suporte por e-mail</li></ul><a class="button button-outline button-wide" asp-controller="Account" asp-action="Register">Criar conta grátis</a></article>
    <article class="plan-card"><span class="eyebrow">Para times em crescimento</span><h2>Pro</h2><div class="plan-price">Em breve <small>/ mês</small></div><p>Mais automação, relatórios e controle para o seu time.</p><ul><li>Projetos ilimitados</li><li>Relatórios avançados</li><li>Permissões personalizadas</li></ul><a class="button button-primary button-wide" asp-controller="Account" asp-action="Register">Entrar na lista de espera</a></article>
</section>
