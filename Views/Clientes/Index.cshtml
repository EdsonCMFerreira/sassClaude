@{
    ViewData["Title"] = "Clientes";
}

<div class="page-heading">
    <div><span class="eyebrow">Cadastro</span><h1>Clientes.</h1><p class="muted">Ficha cadastral completa do cliente.</p></div>
    <div class="hero-actions" style="flex-wrap:wrap;">
        <a class="button button-outline" style="color:var(--blue);" asp-controller="Clientes" asp-action="PessoaFisica">Ver pessoa física <span>→</span></a>
        <a class="button button-outline" style="color:var(--blue);" asp-controller="Clientes" asp-action="PessoaJuridica">Ver pessoa jurídica <span>→</span></a>
    </div>
</div>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Clientes cadastrados</h2><p class="muted">Dados pessoais, endereço de cobrança e de entrega. A última compra é calculada automaticamente a partir dos registros em Pedidos.</p></div></div>
    <div class="user-form-wrap">
        <form id="clienteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="clienteId" />
            <div class="user-form-grid">
                <div><label for="nome">Nome / Razão social</label><input id="nome" required /></div>
                <div><label for="dataCadastro">Data de cadastro</label><input id="dataCadastro" type="date" required /></div>
                <div><label for="tipoPessoa">Tipo de pessoa</label><select id="tipoPessoa"><option value="Física">Física</option><option value="Jurídica">Jurídica</option></select></div>
                <div><label for="cpfCnpj">CPF/CNPJ</label><input id="cpfCnpj" required /></div>
                <div><label for="email">E-mail</label><input id="email" type="email" /></div>
                <div><label for="site">Site</label><input id="site" type="url" placeholder="https://" /></div>
                <div><label for="telefone">Telefone</label><input id="telefone" /></div>

                <div class="form-section-title">Endereço de cobrança</div>
                <div><label for="cobrancaCep">CEP</label><input id="cobrancaCep" /></div>
                <div><label for="cobrancaEndereco">Endereço</label><input id="cobrancaEndereco" /></div>
                <div><label for="cobrancaNumero">Número</label><input id="cobrancaNumero" /></div>
                <div><label for="cobrancaComplemento">Complemento</label><input id="cobrancaComplemento" /></div>
                <div><label for="cobrancaBairro">Bairro</label><input id="cobrancaBairro" /></div>
                <div><label for="cobrancaCidade">Cidade</label><input id="cobrancaCidade" /></div>
                <div><label for="cobrancaUf">UF</label><select id="cobrancaUf"><option value="">Selecione...</option><option value="AC">AC - Acre</option><option value="AL">AL - Alagoas</option><option value="AP">AP - Amapá</option><option value="AM">AM - Amazonas</option><option value="BA">BA - Bahia</option><option value="CE">CE - Ceará</option><option value="DF">DF - Distrito Federal</option><option value="ES">ES - Espírito Santo</option><option value="GO">GO - Goiás</option><option value="MA">MA - Maranhão</option><option value="MT">MT - Mato Grosso</option><option value="MS">MS - Mato Grosso do Sul</option><option value="MG">MG - Minas Gerais</option><option value="PA">PA - Pará</option><option value="PB">PB - Paraíba</option><option value="PR">PR - Paraná</option><option value="PE">PE - Pernambuco</option><option value="PI">PI - Piauí</option><option value="RJ">RJ - Rio de Janeiro</option><option value="RN">RN - Rio Grande do Norte</option><option value="RS">RS - Rio Grande do Sul</option><option value="RO">RO - Rondônia</option><option value="RR">RR - Roraima</option><option value="SC">SC - Santa Catarina</option><option value="SP">SP - São Paulo</option><option value="SE">SE - Sergipe</option><option value="TO">TO - Tocantins</option></select></div>

                <div class="form-section-title form-section-title-with-toggle">
                    <span>Endereço de entrega</span>
                    <label class="inline-checkbox"><input type="checkbox" id="entregaIgualCobranca" checked /> Igual ao de cobrança</label>
                </div>
                <div><label for="entregaCep">CEP</label><input id="entregaCep" /></div>
                <div><label for="entregaEndereco">Endereço</label><input id="entregaEndereco" /></div>
                <div><label for="entregaNumero">Número</label><input id="entregaNumero" /></div>
                <div><label for="entregaComplemento">Complemento</label><input id="entregaComplemento" /></div>
                <div><label for="entregaBairro">Bairro</label><input id="entregaBairro" /></div>
                <div><label for="entregaCidade">Cidade</label><input id="entregaCidade" /></div>
                <div><label for="entregaUf">UF</label><select id="entregaUf"><option value="">Selecione...</option><option value="AC">AC - Acre</option><option value="AL">AL - Alagoas</option><option value="AP">AP - Amapá</option><option value="AM">AM - Amazonas</option><option value="BA">BA - Bahia</option><option value="CE">CE - Ceará</option><option value="DF">DF - Distrito Federal</option><option value="ES">ES - Espírito Santo</option><option value="GO">GO - Goiás</option><option value="MA">MA - Maranhão</option><option value="MT">MT - Mato Grosso</option><option value="MS">MS - Mato Grosso do Sul</option><option value="MG">MG - Minas Gerais</option><option value="PA">PA - Pará</option><option value="PB">PB - Paraíba</option><option value="PR">PR - Paraná</option><option value="PE">PE - Pernambuco</option><option value="PI">PI - Piauí</option><option value="RJ">RJ - Rio de Janeiro</option><option value="RN">RN - Rio Grande do Norte</option><option value="RS">RS - Rio Grande do Sul</option><option value="RO">RO - Rondônia</option><option value="RR">RR - Roraima</option><option value="SC">SC - Santa Catarina</option><option value="SP">SP - São Paulo</option><option value="SE">SE - Sergipe</option><option value="TO">TO - Tocantins</option></select></div>

                <div class="field-full"><label for="observacoes">Observações</label><textarea id="observacoes" rows="3"></textarea></div>

                <div class="user-form-actions"><button type="submit" class="button button-primary">Salvar</button><button type="button" id="cancelEdit" class="button button-outline hidden">Cancelar</button></div>
            </div>
        </form>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Data cadastro</th>
                    <th>CPF/CNPJ</th>
                    <th>Telefone</th>
                    <th>Cidade/UF (cobrança)</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="clienteTableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('clienteForm');
        const clienteId = document.getElementById('clienteId');
        const nome = document.getElementById('nome');
        const dataCadastro = document.getElementById('dataCadastro');
        const tipoPessoa = document.getElementById('tipoPessoa');
        const cpfCnpj = document.getElementById('cpfCnpj');
        const email = document.getElementById('email');
        const site = document.getElementById('site');
        const telefone = document.getElementById('telefone');
        const cobrancaCep = document.getElementById('cobrancaCep');
        const cobrancaEndereco = document.getElementById('cobrancaEndereco');
        const cobrancaNumero = document.getElementById('cobrancaNumero');
        const cobrancaComplemento = document.getElementById('cobrancaComplemento');
        const cobrancaBairro = document.getElementById('cobrancaBairro');
        const cobrancaCidade = document.getElementById('cobrancaCidade');
        const cobrancaUf = document.getElementById('cobrancaUf');
        const entregaIgualCobranca = document.getElementById('entregaIgualCobranca');
        const entregaCep = document.getElementById('entregaCep');
        const entregaEndereco = document.getElementById('entregaEndereco');
        const entregaNumero = document.getElementById('entregaNumero');
        const entregaComplemento = document.getElementById('entregaComplemento');
        const entregaBairro = document.getElementById('entregaBairro');
        const entregaCidade = document.getElementById('entregaCidade');
        const entregaUf = document.getElementById('entregaUf');
        const entregaFields = [entregaCep, entregaEndereco, entregaNumero, entregaComplemento, entregaBairro, entregaCidade, entregaUf];
        const observacoes = document.getElementById('observacoes');
        const cancelEdit = document.getElementById('cancelEdit');
        const tableBody = document.getElementById('clienteTableBody');
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function formatDate(value) {
            return new Date(value).toLocaleDateString('pt-BR', { timeZone: 'UTC' });
        }

        function hoje() {
            return new Date().toISOString().slice(0, 10);
        }

        dataCadastro.value = hoje();

        async function buscarCep(cepValue, campos) {
            const cepDigits = cepValue.replace(/\D/g, '');
            if (cepDigits.length !== 8) return;

            try {
                const response = await fetch(`https://viacep.com.br/ws/${cepDigits}/json/`);
                if (!response.ok) return;

                const data = await response.json();
                if (data.erro) return;

                campos.endereco.value = data.logradouro || campos.endereco.value;
                campos.bairro.value = data.bairro || campos.bairro.value;
                campos.cidade.value = data.localidade || campos.cidade.value;
                campos.uf.value = data.uf || campos.uf.value;
                campos.complemento.value = data.complemento || campos.complemento.value;
                if (campos.aposPreencher) campos.aposPreencher();
            } catch (error) {
                console.error('Erro ao buscar CEP.', error);
            }
        }

        cobrancaCep.addEventListener('input', () => buscarCep(cobrancaCep.value, {
            endereco: cobrancaEndereco, bairro: cobrancaBairro, cidade: cobrancaCidade, uf: cobrancaUf, complemento: cobrancaComplemento,
            aposPreencher: () => syncEntregaComCobranca()
        }));

        entregaCep.addEventListener('input', () => buscarCep(entregaCep.value, {
            endereco: entregaEndereco, bairro: entregaBairro, cidade: entregaCidade, uf: entregaUf, complemento: entregaComplemento
        }));

        function syncEntregaComCobranca() {
            if (!entregaIgualCobranca.checked) return;
            entregaCep.value = cobrancaCep.value;
            entregaEndereco.value = cobrancaEndereco.value;
            entregaNumero.value = cobrancaNumero.value;
            entregaComplemento.value = cobrancaComplemento.value;
            entregaBairro.value = cobrancaBairro.value;
            entregaCidade.value = cobrancaCidade.value;
            entregaUf.value = cobrancaUf.value;
        }

        function updateEntregaDisabled() {
            entregaFields.forEach(field => { field.disabled = entregaIgualCobranca.checked; });
            syncEntregaComCobranca();
        }

        async function loadClientes() {
            const response = await fetch('/api/clientes');
            if (!response.ok) {
                throw new Error('Erro ao carregar clientes.');
            }

            const data = await response.json();
            tableBody.innerHTML = data.map(item => `
                <tr>
                    <td>${item.nome}</td>
                    <td>${formatDate(item.createdAt)}</td>
                    <td>${item.cpfCnpj}</td>
                    <td>${item.telefone || '—'}</td>
                    <td>${[item.cobrancaCidade, item.cobrancaUf].filter(Boolean).join('/') || '—'}</td>
                    <td>
                        <button class="table-action" data-edit="${item.id}">Editar</button>
                        <button class="table-action danger" data-delete="${item.id}">Excluir</button>
                    </td>
                </tr>
            `).join('') || '<tr><td colspan="6" class="muted">Nenhum cliente cadastrado ainda.</td></tr>';

            tableBody.querySelectorAll('[data-edit]').forEach(button => {
                button.addEventListener('click', () => editCliente(Number(button.dataset.edit)));
            });

            tableBody.querySelectorAll('[data-delete]').forEach(button => {
                button.addEventListener('click', () => deleteCliente(Number(button.dataset.delete)));
            });
        }

        async function editCliente(id) {
            const response = await fetch(`/api/clientes/${id}`);
            const data = await response.json();
            clienteId.value = data.id;
            nome.value = data.nome;
            dataCadastro.value = data.createdAt.slice(0, 10);
            tipoPessoa.value = data.tipoPessoa;
            cpfCnpj.value = data.cpfCnpj;
            email.value = data.email;
            site.value = data.site;
            telefone.value = data.telefone;
            cobrancaCep.value = data.cobrancaCep;
            cobrancaEndereco.value = data.cobrancaEndereco;
            cobrancaNumero.value = data.cobrancaNumero;
            cobrancaComplemento.value = data.cobrancaComplemento;
            cobrancaBairro.value = data.cobrancaBairro;
            cobrancaCidade.value = data.cobrancaCidade;
            cobrancaUf.value = data.cobrancaUf;

            const enderecosIguais = data.cobrancaCep === data.entregaCep &&
                data.cobrancaEndereco === data.entregaEndereco &&
                data.cobrancaNumero === data.entregaNumero &&
                data.cobrancaComplemento === data.entregaComplemento &&
                data.cobrancaBairro === data.entregaBairro &&
                data.cobrancaCidade === data.entregaCidade &&
                data.cobrancaUf === data.entregaUf;

            entregaIgualCobranca.checked = enderecosIguais;
            entregaCep.value = data.entregaCep;
            entregaEndereco.value = data.entregaEndereco;
            entregaNumero.value = data.entregaNumero;
            entregaComplemento.value = data.entregaComplemento;
            entregaBairro.value = data.entregaBairro;
            entregaCidade.value = data.entregaCidade;
            entregaUf.value = data.entregaUf;
            updateEntregaDisabled();
            observacoes.value = data.observacoes;

            cancelEdit.classList.remove('hidden');
            nome.focus();
        }

        async function deleteCliente(id) {
            const confirmed = confirm('Deseja excluir este cliente?');
            if (!confirmed) return;

            const response = await fetch(`/api/clientes/${id}`, { method: 'DELETE', headers: { 'X-CSRF-TOKEN': csrfToken } });
            if (response.ok) {
                await loadClientes();
            }
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            syncEntregaComCobranca();

            const payload = {
                id: Number(clienteId.value || 0),
                nome: nome.value.trim(),
                createdAt: dataCadastro.value,
                tipoPessoa: tipoPessoa.value,
                cpfCnpj: cpfCnpj.value.trim(),
                email: email.value.trim(),
                site: site.value.trim(),
                telefone: telefone.value.trim(),
                cobrancaCep: cobrancaCep.value.trim(),
                cobrancaEndereco: cobrancaEndereco.value.trim(),
                cobrancaNumero: cobrancaNumero.value.trim(),
                cobrancaComplemento: cobrancaComplemento.value.trim(),
                cobrancaBairro: cobrancaBairro.value.trim(),
                cobrancaCidade: cobrancaCidade.value.trim(),
                cobrancaUf: cobrancaUf.value.trim(),
                entregaCep: entregaCep.value.trim(),
                entregaEndereco: entregaEndereco.value.trim(),
                entregaNumero: entregaNumero.value.trim(),
                entregaComplemento: entregaComplemento.value.trim(),
                entregaBairro: entregaBairro.value.trim(),
                entregaCidade: entregaCidade.value.trim(),
                entregaUf: entregaUf.value.trim(),
                observacoes: observacoes.value.trim()
            };

            const method = payload.id ? 'PUT' : 'POST';
            const url = payload.id ? `/api/clientes/${payload.id}` : '/api/clientes';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                form.reset();
                clienteId.value = '';
                dataCadastro.value = hoje();
                entregaIgualCobranca.checked = true;
                updateEntregaDisabled();
                cancelEdit.classList.add('hidden');
                await loadClientes();
            } else {
                const errorText = await response.text();
                alert(errorText || 'Erro ao salvar cliente.');
            }
        });

        cancelEdit.addEventListener('click', () => {
            form.reset();
            clienteId.value = '';
            dataCadastro.value = hoje();
            entregaIgualCobranca.checked = true;
            updateEntregaDisabled();
            cancelEdit.classList.add('hidden');
        });

        entregaIgualCobranca.addEventListener('change', updateEntregaDisabled);
        [cobrancaCep, cobrancaEndereco, cobrancaNumero, cobrancaComplemento, cobrancaBairro, cobrancaCidade, cobrancaUf].forEach(field => {
            field.addEventListener('input', syncEntregaComCobranca);
            field.addEventListener('change', syncEntregaComCobranca);
        });

        updateEntregaDisabled();
        loadClientes()
            .then(() => {
                const editarId = new URLSearchParams(window.location.search).get('editar');
                if (editarId) {
                    editCliente(Number(editarId));
                }
            })
            .catch(error => console.error(error));
    </script>
}
