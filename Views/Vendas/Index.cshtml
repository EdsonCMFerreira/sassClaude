@{
    ViewData["Title"] = "Vendas";
}

<div class="page-heading">
    <div><span class="eyebrow">Movimentação</span><h1>Vendas.</h1><p class="muted">Registre as vendas feitas aos clientes.</p></div>
</div>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Vendas registradas</h2><p class="muted">Cliente, produto, quantidade, valores e data.</p></div></div>
    <div class="user-form-wrap">
        <form id="vendaForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="vendaId" />
            <div class="user-form-grid">
                <div><label for="clienteId">Cliente</label><select id="clienteId" required><option value="">Selecione...</option></select></div>
                <div><label for="productId">Produto</label><select id="productId" required><option value="">Selecione...</option></select></div>
                <div><label for="fornecedorNome">Fornecedor</label><input id="fornecedorNome" type="text" readonly disabled /></div>
                <div><label for="quantidade">Quantidade</label><input id="quantidade" type="number" min="1" step="1" value="1" required /></div>
                <div><label for="valorUnitario">Valor unitário</label><input id="valorUnitario" type="number" step="0.01" min="0" required /></div>
                <div><label for="valorTotal">Valor total</label><input id="valorTotal" type="text" readonly disabled /></div>
                <div><label for="dataVenda">Data da venda</label><input id="dataVenda" type="date" required /></div>
                <div><label for="numeroNota">Número da nota</label><input id="numeroNota" /></div>
                <div><label for="formaPagamento">Forma de pagamento</label><select id="formaPagamento"><option value="">Selecione...</option><option>Dinheiro</option><option>Cartão de crédito</option><option>Cartão de débito</option><option>PIX</option><option>Boleto</option><option>Transferência</option></select></div>
                <div><label for="status">Status</label><select id="status"><option>Pendente</option><option>Concluída</option><option>Cancelada</option></select></div>
                <div><label for="observacoes">Observações</label><input id="observacoes" /></div>
                <div class="user-form-actions"><button type="submit" class="button button-primary">Salvar</button><button type="button" id="cancelEdit" class="button button-outline hidden">Cancelar</button></div>
            </div>
        </form>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light">
                <tr>
                    <th>Cliente</th>
                    <th>Produto</th>
                    <th>Qtd.</th>
                    <th>Valor unitário</th>
                    <th>Valor total</th>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="vendaTableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('vendaForm');
        const vendaId = document.getElementById('vendaId');
        const clienteId = document.getElementById('clienteId');
        const productId = document.getElementById('productId');
        const fornecedorNome = document.getElementById('fornecedorNome');
        const quantidade = document.getElementById('quantidade');
        const valorUnitario = document.getElementById('valorUnitario');
        const valorTotal = document.getElementById('valorTotal');
        const dataVenda = document.getElementById('dataVenda');
        const numeroNota = document.getElementById('numeroNota');
        const formaPagamento = document.getElementById('formaPagamento');
        const status = document.getElementById('status');
        const observacoes = document.getElementById('observacoes');
        const cancelEdit = document.getElementById('cancelEdit');
        const tableBody = document.getElementById('vendaTableBody');
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let allProducts = [];

        function formatCurrency(value) {
            return Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function formatDate(value) {
            return value ? new Date(value).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '—';
        }

        function updateValorTotalPreview() {
            const qtd = Number(quantidade.value) || 0;
            const unitario = Number(valorUnitario.value) || 0;
            valorTotal.value = formatCurrency(qtd * unitario);
        }

        async function loadClientesOptions() {
            const response = await fetch('/api/clientes');
            const data = await response.json();
            clienteId.innerHTML = '<option value="">Selecione...</option>' + data.map(item =>
                `<option value="${item.id}">${item.nome} — ${item.cpfCnpj}</option>`
            ).join('');
        }

        async function loadProductsOptions() {
            const response = await fetch('/api/products');
            allProducts = await response.json();
            productId.innerHTML = '<option value="">Selecione...</option>' + allProducts.map(item =>
                `<option value="${item.id}">${item.codigo} — ${item.descricao}</option>`
            ).join('');
        }

        function updateFornecedorPreview() {
            const produto = allProducts.find(item => item.id === Number(productId.value));
            fornecedorNome.value = produto ? produto.fornecedorNome : '';
        }

        function onProductSelected() {
            const produto = allProducts.find(item => item.id === Number(productId.value));
            fornecedorNome.value = produto ? produto.fornecedorNome : '';
            if (produto) {
                valorUnitario.value = produto.valorVenda;
            }
            updateValorTotalPreview();
        }

        async function loadVendas() {
            const response = await fetch('/api/vendas');
            if (!response.ok) {
                throw new Error('Erro ao carregar vendas.');
            }

            const data = await response.json();
            tableBody.innerHTML = data.map(item => `
                <tr>
                    <td>${item.clienteNome}</td>
                    <td>${item.productNome}</td>
                    <td>${item.quantidade}</td>
                    <td>${formatCurrency(item.valorUnitario)}</td>
                    <td>${formatCurrency(item.valorTotal)}</td>
                    <td>${formatDate(item.dataVenda)}</td>
                    <td>${item.status}</td>
                    <td>
                        <a class="table-action" href="/Vendas/Recibo/${item.id}" target="_blank" rel="noopener">Recibo</a>
                        <button class="table-action" data-edit="${item.id}">Editar</button>
                        <button class="table-action danger" data-delete="${item.id}">Excluir</button>
                    </td>
                </tr>
            `).join('') || '<tr><td colspan="8" class="muted">Nenhuma venda registrada ainda.</td></tr>';

            tableBody.querySelectorAll('[data-edit]').forEach(button => {
                button.addEventListener('click', () => editVenda(Number(button.dataset.edit)));
            });

            tableBody.querySelectorAll('[data-delete]').forEach(button => {
                button.addEventListener('click', () => deleteVenda(Number(button.dataset.delete)));
            });
        }

        async function editVenda(id) {
            const response = await fetch(`/api/vendas/${id}`);
            const data = await response.json();
            vendaId.value = data.id;
            clienteId.value = data.clienteId;
            productId.value = data.productId;
            updateFornecedorPreview();
            quantidade.value = data.quantidade;
            valorUnitario.value = data.valorUnitario;
            dataVenda.value = data.dataVenda.slice(0, 10);
            numeroNota.value = data.numeroNota;
            formaPagamento.value = data.formaPagamento;
            status.value = data.status;
            observacoes.value = data.observacoes;
            updateValorTotalPreview();
            cancelEdit.classList.remove('hidden');
            clienteId.focus();
        }

        async function deleteVenda(id) {
            const confirmed = confirm('Deseja excluir esta venda?');
            if (!confirmed) return;

            const response = await fetch(`/api/vendas/${id}`, { method: 'DELETE', headers: { 'X-CSRF-TOKEN': csrfToken } });
            if (response.ok) {
                await loadVendas();
            }
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            const payload = {
                id: Number(vendaId.value || 0),
                clienteId: Number(clienteId.value),
                productId: Number(productId.value),
                quantidade: Number(quantidade.value),
                valorUnitario: Number(valorUnitario.value),
                dataVenda: dataVenda.value,
                numeroNota: numeroNota.value.trim(),
                formaPagamento: formaPagamento.value,
                status: status.value,
                observacoes: observacoes.value.trim()
            };

            const method = payload.id ? 'PUT' : 'POST';
            const url = payload.id ? `/api/vendas/${payload.id}` : '/api/vendas';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                form.reset();
                vendaId.value = '';
                valorTotal.value = '';
                fornecedorNome.value = '';
                cancelEdit.classList.add('hidden');
                await loadVendas();
            } else {
                const errorText = await response.text();
                alert(errorText || 'Erro ao salvar venda.');
            }
        });

        cancelEdit.addEventListener('click', () => {
            form.reset();
            vendaId.value = '';
            valorTotal.value = '';
            fornecedorNome.value = '';
            cancelEdit.classList.add('hidden');
        });

        quantidade.addEventListener('input', updateValorTotalPreview);
        valorUnitario.addEventListener('input', updateValorTotalPreview);
        productId.addEventListener('change', onProductSelected);

        Promise.all([loadClientesOptions(), loadProductsOptions()])
            .then(loadVendas)
            .catch(error => console.error(error));
    </script>
}
