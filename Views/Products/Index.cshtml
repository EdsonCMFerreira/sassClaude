@{
    ViewData["Title"] = "Produtos";
}

<div class="page-heading">
    <div><span class="eyebrow">Catálogo</span><h1>Produtos.</h1><p class="muted">Gerencie o cadastro de produtos do workspace.</p></div>
    <div class="hero-actions"><a class="button button-outline" style="color:var(--blue);" asp-controller="Products" asp-action="Dashboard">Ver dashboard <span>→</span></a></div>
</div>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>Produtos cadastrados</h2><p class="muted">Código, descrição, validade, valores, fornecedor e quantidade. O saldo é calculado como quantidade menos o total já pedido.</p></div></div>
    <div class="user-form-wrap">
        <form id="productForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="productId" />
            <div class="user-form-grid">
                <div><label for="codigo">Código</label><input id="codigo" required /></div>
                <div><label for="descricao">Descrição</label><input id="descricao" required /></div>
                <div><label for="validade">Validade</label><input id="validade" type="date" required /></div>
                <div><label for="valorCompra">Valor de compra unitário</label><input id="valorCompra" type="number" step="0.01" min="0" required /></div>
                <div><label for="valorVenda">Valor de venda unitário</label><input id="valorVenda" type="number" step="0.01" min="0" required /></div>
                <div><label for="percentualLucro">% de lucro</label><input id="percentualLucro" type="text" readonly disabled /></div>
                <div><label for="fornecedorId">Fornecedor</label><select id="fornecedorId" required><option value="">Selecione...</option></select></div>
                <div><label for="quantidade">Quantidade</label><input id="quantidade" type="number" step="1" min="0" required /></div>
                <div class="user-form-actions"><button type="submit" class="button button-primary">Salvar</button><button type="button" id="cancelEdit" class="button button-outline hidden">Cancelar</button></div>
            </div>
        </form>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th>Validade</th>
                    <th>Valor de compra unitário</th>
                    <th>Valor de venda unitário</th>
                    <th>% de lucro</th>
                    <th>Fornecedor</th>
                    <th>Quantidade</th>
                    <th>Saldo</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="productTableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('productForm');
        const productId = document.getElementById('productId');
        const codigo = document.getElementById('codigo');
        const descricao = document.getElementById('descricao');
        const validade = document.getElementById('validade');
        const valorCompra = document.getElementById('valorCompra');
        const valorVenda = document.getElementById('valorVenda');
        const percentualLucro = document.getElementById('percentualLucro');
        const fornecedorId = document.getElementById('fornecedorId');
        const quantidade = document.getElementById('quantidade');
        const cancelEdit = document.getElementById('cancelEdit');
        const tableBody = document.getElementById('productTableBody');
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function formatCurrency(value) {
            return Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function formatPercent(value) {
            return `${Number(value).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}%`;
        }

        function formatDate(value) {
            return new Date(value).toLocaleDateString('pt-BR', { timeZone: 'UTC' });
        }

        function calcularLucro(compra, venda) {
            return compra > 0 ? ((venda - compra) / compra) * 100 : 0;
        }

        function updateLucroPreview() {
            const compra = Number(valorCompra.value) || 0;
            const venda = Number(valorVenda.value) || 0;
            percentualLucro.value = formatPercent(calcularLucro(compra, venda));
        }

        async function loadFornecedoresOptions() {
            const response = await fetch('/api/fornecedores');
            if (!response.ok) {
                throw new Error('Erro ao carregar fornecedores.');
            }

            const data = await response.json();
            fornecedorId.innerHTML = '<option value="">Selecione...</option>' + data.map(item =>
                `<option value="${item.id}">${item.nome} — ${item.cpfCnpj}</option>`
            ).join('');
        }

        async function loadProducts() {
            const response = await fetch('/api/products');
            if (!response.ok) {
                throw new Error('Erro ao carregar produtos.');
            }

            const data = await response.json();
            tableBody.innerHTML = data.map(item => `
                <tr>
                    <td>${item.codigo}</td>
                    <td>${item.descricao}</td>
                    <td>${formatDate(item.validade)}</td>
                    <td>${formatCurrency(item.valorCompra)}</td>
                    <td>${formatCurrency(item.valorVenda)}</td>
                    <td>${formatPercent(item.percentualLucro)}</td>
                    <td>${item.fornecedorNome}</td>
                    <td>${item.quantidade}</td>
                    <td class="${item.saldo < 0 ? 'text-negative' : ''}">${item.saldo}</td>
                    <td>
                        <button class="table-action" data-edit="${item.id}">Editar</button>
                        <button class="table-action danger" data-delete="${item.id}">Excluir</button>
                    </td>
                </tr>
            `).join('') || '<tr><td colspan="10" class="muted">Nenhum produto cadastrado ainda.</td></tr>';

            tableBody.querySelectorAll('[data-edit]').forEach(button => {
                button.addEventListener('click', () => editProduct(Number(button.dataset.edit)));
            });

            tableBody.querySelectorAll('[data-delete]').forEach(button => {
                button.addEventListener('click', () => deleteProduct(Number(button.dataset.delete)));
            });
        }

        async function editProduct(id) {
            const response = await fetch(`/api/products/${id}`);
            const data = await response.json();
            productId.value = data.id;
            codigo.value = data.codigo;
            descricao.value = data.descricao;
            validade.value = data.validade.slice(0, 10);
            valorCompra.value = data.valorCompra;
            valorVenda.value = data.valorVenda;
            fornecedorId.value = data.fornecedorId;
            quantidade.value = data.quantidade;
            updateLucroPreview();
            cancelEdit.classList.remove('hidden');
            codigo.focus();
        }

        async function deleteProduct(id) {
            const confirmed = confirm('Deseja excluir este produto?');
            if (!confirmed) return;

            const response = await fetch(`/api/products/${id}`, { method: 'DELETE', headers: { 'X-CSRF-TOKEN': csrfToken } });
            if (response.ok) {
                await loadProducts();
            }
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();

            if (Number(valorVenda.value) <= Number(valorCompra.value)) {
                alert('O valor de venda deve ser maior que o valor de compra.');
                return;
            }

            const payload = {
                id: Number(productId.value || 0),
                codigo: codigo.value.trim(),
                descricao: descricao.value.trim(),
                validade: validade.value,
                valorCompra: Number(valorCompra.value),
                valorVenda: Number(valorVenda.value),
                fornecedorId: Number(fornecedorId.value),
                quantidade: Number(quantidade.value)
            };

            const method = payload.id ? 'PUT' : 'POST';
            const url = payload.id ? `/api/products/${payload.id}` : '/api/products';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                form.reset();
                productId.value = '';
                percentualLucro.value = '';
                cancelEdit.classList.add('hidden');
                await loadProducts();
            } else {
                const errorText = await response.text();
                alert(errorText || 'Erro ao salvar produto.');
            }
        });

        cancelEdit.addEventListener('click', () => {
            form.reset();
            productId.value = '';
            percentualLucro.value = '';
            cancelEdit.classList.add('hidden');
        });

        valorCompra.addEventListener('input', updateLucroPreview);
        valorVenda.addEventListener('input', updateLucroPreview);

        loadFornecedoresOptions()
            .then(loadProducts)
            .catch(error => console.error(error));
    </script>
}
