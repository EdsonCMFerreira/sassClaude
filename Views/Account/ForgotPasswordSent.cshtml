@{
    ViewData["Title"] = "Verifique seu e-mail";
    Layout = "_AuthLayout";
}
<div class="auth-shell"><section class="auth-promo"><div class="brand-lockup"><span class="brand-mark">s</span> sassClaude</div><div class="promo-copy"><span class="eyebrow">Quase lá</span><h1>Confira sua caixa de entrada.</h1><p>Se houver uma conta com esse e-mail, você receberá um link para redefinir a senha.</p></div><div class="promo-foot">Por segurança, esta mensagem é igual para todos os endereços.</div></section><section class="auth-panel"><div class="auth-card"><div class="mobile-brand"><span class="brand-mark">s</span> sassClaude</div><span class="eyebrow">E-mail enviado</span><h2>Verifique seu e-mail</h2><p class="muted">O link é válido por 30 minutos. Caso não encontre a mensagem, verifique a pasta de spam.</p>
@if (TempData["DevelopmentResetUrl"] is string resetUrl)
{
    <div class="development-notice"><strong>SMTP não configurado</strong><span>Em desenvolvimento, use este link para testar:</span><a href="@resetUrl">Redefinir senha</a></div>
}
<a class="button button-primary button-wide" asp-action="Login">Voltar para entrar <span>→</span></a></div></section></div>
