@model RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <section class="auth-promo auth-promo-register">
        <div class="brand-lockup"><span class="brand-mark">s</span> sassClaude</div>
        <div class="promo-copy">
            <span class="eyebrow">Comece agora</span>
            <h1>Um novo jeito de organizar o seu dia.</h1>
            <p>Crie seu workspace e tenha uma visão mais tranquila das coisas importantes.</p>
        </div>
        <div class="promo-foot">Seu próximo passo começa aqui.</div>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <div class="mobile-brand"><span class="brand-mark">s</span> sassClaude</div>
            <span class="eyebrow">Primeiro acesso</span>
            <h2>Crie sua conta</h2>
            <p class="muted">Leva menos de um minuto.</p>
            <form asp-action="Register" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" placeholder="Como podemos chamar você?" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" placeholder="voce@empresa.com" />
                <span asp-validation-for="Email" class="field-error"></span>
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" placeholder="Mínimo de 6 caracteres" />
                <span asp-validation-for="Password" class="field-error"></span>
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repita sua senha" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                <button class="button button-primary button-wide" type="submit">Criar conta <span>→</span></button>
            </form>
            <p class="auth-switch">Já possui uma conta? <a asp-action="Login">Entrar</a></p>
        </div>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
