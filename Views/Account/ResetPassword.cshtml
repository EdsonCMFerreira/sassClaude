@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Criar nova senha";
    Layout = "_AuthLayout";
}
<div class="auth-shell"><section class="auth-promo auth-promo-register"><div class="brand-lockup"><span class="brand-mark">s</span> sassClaude</div><div class="promo-copy"><span class="eyebrow">Último passo</span><h1>Uma senha nova, e você está de volta.</h1><p>Escolha uma senha forte para proteger sua conta.</p></div><div class="promo-foot">Nunca compartilhe sua senha.</div></section><section class="auth-panel"><div class="auth-card"><div class="mobile-brand"><span class="brand-mark">s</span> sassClaude</div><span class="eyebrow">Redefinir senha</span><h2>Crie uma nova senha</h2><p class="muted">Use pelo menos 6 caracteres.</p><form asp-action="ResetPassword" method="post" class="auth-form"><input asp-for="Token" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" placeholder="Nova senha" autofocus /><span asp-validation-for="Password" class="field-error"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repita sua senha" /><span asp-validation-for="ConfirmPassword" class="field-error"></span><button class="button button-primary button-wide" type="submit">Salvar nova senha <span>→</span></button></form></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
