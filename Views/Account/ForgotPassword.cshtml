@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
    Layout = "_AuthLayout";
}
<div class="auth-shell">
    <section class="auth-promo"><div class="brand-lockup"><span class="brand-mark">S</span> Saas</div><div class="promo-copy"><span class="eyebrow">Acesso seguro</span><h1>Volte ao seu workspace.</h1><p>Vamos enviar um link seguro para o e-mail cadastrado na sua conta.</p></div><div class="promo-foot">O link expira em 30 minutos.</div></section>
    <section class="auth-panel"><div class="auth-card"><div class="mobile-brand"><span class="brand-mark">S</span> Saas</div><span class="eyebrow">Recuperar acesso</span><h2>Esqueceu sua senha?</h2><p class="muted">Informe seu e-mail e enviaremos as instruções para criar uma nova senha.</p><form asp-action="ForgotPassword" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="voce@empresa.com" autofocus /><span asp-validation-for="Email" class="field-error"></span><button class="button button-primary button-wide" type="submit">Enviar link <span>→</span></button></form><p class="auth-switch"><a asp-action="Login">← Voltar para entrar</a></p></div></section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
