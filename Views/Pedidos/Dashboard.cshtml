@model PedidoDashboardViewModel
@{
    ViewData["Title"] = "Dashboard de pedidos";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
}
<div class="page-heading">
    <div><span class="eyebrow">Movimentação</span><h1>Dashboard de pedidos.</h1><p class="muted">Faturamento, status e produtos mais pedidos.</p></div>
    <a class="button button-outline" asp-controller="Pedidos" asp-action="Index">← Ver pedidos</a>
</div>

<div class="surface-card users-card" style="padding:20px 27px;">
    <form method="get" asp-action="Dashboard" class="settings-form filter-form">
        <div><label for="ano">Ano</label>
            <select id="ano" name="ano" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var anoOpcao in Model.AnosDisponiveis)
                {
                    if (anoOpcao == Model.AnoSelecionado)
                    {
                        <option value="@anoOpcao" selected>@anoOpcao</option>
                    }
                    else
                    {
                        <option value="@anoOpcao">@anoOpcao</option>
                    }
                }
            </select>
        </div>
        <div><label for="mes">Mês</label>
            <select id="mes" name="mes" onchange="this.form.submit()" disabled="@(!Model.AnoSelecionado.HasValue)">
                <option value="">Todos</option>
                @for (var m = 1; m <= 12; m++)
                {
                    var nomeMes = char.ToUpper(ptBr.DateTimeFormat.GetMonthName(m)[0]) + ptBr.DateTimeFormat.GetMonthName(m)[1..];
                    if (m == Model.MesSelecionado)
                    {
                        <option value="@m" selected>@nomeMes</option>
                    }
                    else
                    {
                        <option value="@m">@nomeMes</option>
                    }
                }
            </select>
        </div>
        @if (Model.AnoSelecionado.HasValue)
        {
            <a asp-action="Dashboard" class="button button-outline">Limpar filtro</a>
        }
    </form>
</div>

<div class="metric-grid">
    <article class="metric-card metric-highlight"><span class="metric-label">Pedidos registrados</span><strong>@Model.TotalPedidos</strong><span class="metric-caption">@Model.PeriodoDescricao</span></article>
    <article class="metric-card"><span class="metric-label">Pendentes</span><strong>@Model.PedidosPendentes</strong><span class="metric-caption">aguardando conclusão</span></article>
    <article class="metric-card"><span class="metric-label">Faturamento (concluídos)</span><strong>@Model.ValorTotalConcluidos.ToString("C", ptBr)</strong><span class="metric-caption">@Model.PeriodoDescricao</span></article>
    <article class="metric-card"><span class="metric-label">Ticket médio</span><strong>@Model.TicketMedio.ToString("C", ptBr)</strong><span class="metric-caption">por pedido concluído</span></article>
</div>

<div class="content-grid">
    <section class="surface-card activity-card">
        <div class="section-heading"><div><span class="eyebrow">Faturamento</span><h2>@Model.FaturamentoTitulo</h2><p class="muted">@Model.ValorTotalConcluidos.ToString("C", ptBr) em pedidos concluídos @Model.PeriodoDescricao.</p></div></div>
        <div style="height:280px;"><canvas id="graficoFaturamento"></canvas></div>
    </section>
    <aside class="settings-stack">
        <div class="surface-card settings-card">
            <span class="eyebrow">Status</span>
            <h2>Pedidos por status</h2>
            @if (!Model.PorStatus.Any())
            {
                <p class="muted">Nenhum pedido registrado @Model.PeriodoDescricao.</p>
            }
            else
            {
                <p class="muted" style="margin-bottom:10px;">@Model.TotalPedidos pedido(s) @Model.PeriodoDescricao.</p>
                <div style="height:220px;"><canvas id="graficoStatus"></canvas></div>
            }
        </div>
        <div class="surface-card settings-card">
            <span class="eyebrow">Produtos</span>
            <h2>Mais pedidos</h2>
            @if (!Model.ProdutosMaisPedidos.Any())
            {
                <p class="muted">Nenhum item de pedido registrado ainda.</p>
            }
            else
            {
                <div style="height:220px;"><canvas id="graficoProdutos"></canvas></div>
            }
        </div>
    </aside>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const tema = getComputedStyle(document.documentElement);
        const cor = nomeVariavel => tema.getPropertyValue(nomeVariavel).trim();

        Chart.defaults.font.family = "'Segoe UI', sans-serif";
        Chart.defaults.color = cor('--muted');
        Chart.defaults.animation.duration = 1300;
        Chart.defaults.animation.easing = 'easeOutQuart';

        const ptBrCurrency = value => Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        function gradiente(ctx, corInicio, corFim) {
            const area = ctx.chart.chartArea;
            if (!area) return corInicio;
            const gradient = ctx.chart.ctx.createLinearGradient(0, area.top, 0, area.bottom);
            gradient.addColorStop(0, corInicio);
            gradient.addColorStop(1, corFim);
            return gradient;
        }

        const faturamentoLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Faturamento.Select(f => f.Rotulo)));
        const faturamentoValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Faturamento.Select(f => f.Total)));

        new Chart(document.getElementById('graficoFaturamento'), {
            type: 'bar',
            data: {
                labels: faturamentoLabels,
                datasets: [{
                    label: 'Faturamento',
                    data: faturamentoValores,
                    backgroundColor: ctx => gradiente(ctx, cor('--flare'), cor('--blue')),
                    hoverBackgroundColor: cor('--ember'),
                    borderRadius: 8,
                    maxBarThickness: 46
                }]
            },
            options: {
                maintainAspectRatio: false,
                animation: { delay: ctx => ctx.type === 'data' ? ctx.dataIndex * 90 : 0 },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ptBrCurrency(ctx.parsed.y) } }
                },
                scales: {
                    y: { grid: { color: cor('--line') }, ticks: { callback: value => ptBrCurrency(value) } },
                    x: { grid: { display: false } }
                }
            }
        });

        const statusCanvas = document.getElementById('graficoStatus');
        if (statusCanvas) {
            const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PorStatus.Select(s => s.Status)));
            const statusValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PorStatus.Select(s => s.Quantidade)));
            const statusCores = { 'Concluída': cor('--green'), 'Pendente': cor('--neutral'), 'Cancelada': cor('--coral'), 'Devolução': cor('--amber') };

            new Chart(statusCanvas, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusValores,
                        backgroundColor: statusLabels.map(s => statusCores[s] || cor('--flare')),
                        borderColor: '#fff',
                        borderWidth: 3,
                        hoverOffset: 10
                    }]
                },
                options: {
                    cutout: '62%',
                    maintainAspectRatio: false,
                    animation: { animateRotate: true, animateScale: true },
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: { callbacks: { label: ctx => `${ctx.label}: ${ctx.parsed} pedido(s)` } }
                    }
                }
            });
        }

        const produtosCanvas = document.getElementById('graficoProdutos');
        if (produtosCanvas) {
            const produtosLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProdutosMaisPedidos.Select(p => p.ProdutoNome)));
            const produtosValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProdutosMaisPedidos.Select(p => p.QuantidadeTotal)));

            new Chart(produtosCanvas, {
                type: 'bar',
                data: {
                    labels: produtosLabels,
                    datasets: [{
                        label: 'Quantidade pedida',
                        data: produtosValores,
                        backgroundColor: ctx => gradiente(ctx, cor('--green'), cor('--blue')),
                        hoverBackgroundColor: cor('--ember'),
                        borderRadius: 8
                    }]
                },
                options: {
                    indexAxis: 'y',
                    maintainAspectRatio: false,
                    animation: { delay: ctx => ctx.type === 'data' ? ctx.dataIndex * 90 : 0 },
                    plugins: { legend: { display: false } },
                    scales: { x: { grid: { color: cor('--line') }, ticks: { precision: 0 } }, y: { grid: { display: false } } }
                }
            });
        }
    </script>
}
