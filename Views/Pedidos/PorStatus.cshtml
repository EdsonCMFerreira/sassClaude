@model PedidoStatusPageViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="page-heading">
    <div><span class="eyebrow">Movimentação</span><h1>@Model.Titulo.</h1><p class="muted">@Model.Descricao</p></div>
    <div class="hero-actions"><a class="button button-outline" style="color:var(--blue);" asp-controller="Pedidos" asp-action="Index">← Ver todos os pedidos</a></div>
</div>
<div class="surface-card users-card">
    <div class="section-heading"><div><h2>@Model.Titulo</h2><p class="muted">Clique em "Editar" para abrir o pedido na tela de Pedidos.</p></div></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead class="table-light">
                <tr>
                    <th>Nº do pedido</th>
                    <th>Cliente</th>
                    <th>Produtos</th>
                    <th>Valor total</th>
                    <th>Data</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="pedidoTableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const tableBody = document.getElementById('pedidoTableBody');
        const statusFiltro = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Status));
        const ordenarAscendente = @(Model.OrdenarAscendente ? "true" : "false");
        const mostrarRecibo = @(Model.MostrarRecibo ? "true" : "false");

        function formatCurrency(value) {
            return Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function formatDate(value) {
            return value ? new Date(value).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '—';
        }

        async function loadPedidosPorStatus() {
            const response = await fetch(`/api/pedidos?status=${encodeURIComponent(statusFiltro)}`);
            if (!response.ok) {
                throw new Error('Erro ao carregar pedidos.');
            }

            const data = await response.json();
            data.sort((a, b) => {
                const diff = new Date(a.dataPedido) - new Date(b.dataPedido);
                return ordenarAscendente ? diff : -diff;
            });

            tableBody.innerHTML = data.map(item => `
                <tr>
                    <td>${item.numeroPedido}</td>
                    <td>${item.clienteNome}</td>
                    <td>${item.itens.map(i => `${i.produtoNome} (x${i.quantidade})`).join(', ')}</td>
                    <td>${formatCurrency(item.valorComDesconto)}</td>
                    <td>${formatDate(item.dataPedido)}</td>
                    <td>
                        ${mostrarRecibo ? `<a class="table-action" href="/Pedidos/Recibo/${item.id}" target="_blank" rel="noopener">Recibo</a>` : ''}
                        <a class="table-action" href="/Pedidos?editar=${item.id}">Editar</a>
                    </td>
                </tr>
            `).join('') || '<tr><td colspan="6" class="muted">Nenhum pedido encontrado.</td></tr>';
        }

        loadPedidosPorStatus().catch(error => console.error(error));
    </script>
}
