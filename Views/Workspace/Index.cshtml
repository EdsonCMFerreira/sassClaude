@{
    ViewData["Title"] = "Workspace";
}
@{
    var isAdmin = User.IsInRole("Admin");
}
<div class="page-heading"><div><span class="eyebrow">Workspace</span><h1>Um lugar para o seu time.</h1><p class="muted">Acompanhe o que importa e mantenha tudo em movimento.</p></div><div class="hero-actions">@if (isAdmin)
    {
        <a class="button button-outline" asp-controller="Workspace" asp-action="Invite">Convidar membro</a>
    }<button class="button button-primary" type="button" onclick="alert('Em breve: novo projeto')">+ Novo projeto</button></div></div>
<div class="workspace-banner"><div><span class="eyebrow">Seu espaço de trabalho</span><h2>Comece com clareza.</h2><p>O painel operacional do Saas está pronto para crescer com você.</p></div><div class="banner-mark">S</div></div>
<div class="project-grid"><article class="surface-card project-card"><div class="project-badge">SC</div><div><h3>Operação principal</h3><p>Seu projeto padrão está pronto para receber o time.</p></div><span class="project-arrow">→</span></article><article class="surface-card project-card project-dashed"><div class="project-badge muted-badge">+</div><div><h3>Adicionar projeto</h3><p>Crie um novo espaço para organizar outra frente.</p></div><span class="project-arrow">→</span></article></div>
