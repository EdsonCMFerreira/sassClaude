<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Saas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Saas.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-top">
                <a class="brand-lockup" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">S</span> Saas</a>
                <button class="mobile-nav-toggle" type="button" onclick="document.body.classList.toggle('nav-open')" aria-label="Abrir menu">☰</button>
            </div>
            <nav class="sidebar-nav">
                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-dropdown">
                        <button type="button" class="nav-dropdown-toggle" onclick="this.closest('.nav-dropdown').classList.toggle('open')">Administração <span class="nav-dropdown-caret">▾</span></button>
                        <div class="nav-dropdown-menu">
                            <a asp-controller="AuditLog" asp-action="Index">Auditoria</a>
                            <a asp-controller="Billing" asp-action="Index">Plano</a>
                            <a asp-controller="Login" asp-action="Index">Usuários</a>
                        </div>
                    </div>
                }
                @{
                    var temAcessoCadastros = User.IsInRole("Admin") || User.HasClaim(TenantClaimTypes.AcessoCadastros, "true");
                    var temAcessoCompras = User.IsInRole("Admin") || User.HasClaim(TenantClaimTypes.AcessoCompras, "true");
                }
                @if (temAcessoCadastros)
                {
                    <div class="nav-dropdown">
                        <button type="button" class="nav-dropdown-toggle" onclick="this.closest('.nav-dropdown').classList.toggle('open')">Cadastros <span class="nav-dropdown-caret">▾</span></button>
                        <div class="nav-dropdown-menu">
                            <a asp-controller="Clientes" asp-action="Index">Clientes</a>
                            <a asp-controller="Fornecedores" asp-action="Index">Fornecedores</a>
                            <a asp-controller="Produtos" asp-action="Index">Produtos</a>
                        </div>
                    </div>
                }
                @if (temAcessoCompras)
                {
                    <a asp-controller="Compras" asp-action="Index">Contas a pagar</a>
                }
                <a asp-controller="Pedidos" asp-action="Index">Contas a receber</a>
                <div class="nav-dropdown">
                    <button type="button" class="nav-dropdown-toggle" onclick="this.closest('.nav-dropdown').classList.toggle('open')">Pesquisa <span class="nav-dropdown-caret">▾</span></button>
                    <div class="nav-dropdown-menu">
                        <a asp-controller="Pesquisa" asp-action="Index">Produtos</a>
                        <a asp-controller="Pesquisa" asp-action="Linkedin">Vagas (LinkedIn)</a>
                    </div>
                </div>
                <div class="nav-dropdown">
                    <button type="button" class="nav-dropdown-toggle" onclick="this.closest('.nav-dropdown').classList.toggle('open')">Relatórios <span class="nav-dropdown-caret">▾</span></button>
                    <div class="nav-dropdown-menu">
                        @if (temAcessoCadastros)
                        {
                            <a asp-controller="Produtos" asp-action="CurvaAbc">Curva ABC de produtos</a>
                        }
                        @if (temAcessoCompras)
                        {
                            <a asp-controller="Compras" asp-action="Dashboard">Dashboard de contas a pagar</a>
                        }
                        <a asp-controller="Pedidos" asp-action="Dashboard">Dashboard de pedidos</a>
                        @if (temAcessoCadastros)
                        {
                            <a asp-controller="Produtos" asp-action="Dashboard">Dashboard de produtos</a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Financeiro" asp-action="Index">Financeiro</a>
                        }
                        @if (temAcessoCadastros)
                        {
                            <a asp-controller="Clientes" asp-action="Ranking">Ranking de clientes</a>
                        }
                    </div>
                </div>
                @if (User.HasClaim(TenantClaimTypes.IsSuperAdmin, "true"))
                {
                    <a asp-controller="SuperAdmin" asp-action="Index">Superadmin</a>
                }
                <a asp-controller="Dashboard" asp-action="Index">Visão geral</a>
                <a asp-controller="Workspace" asp-action="Index">Workspace</a>
            </nav>
            <div class="sidebar-footer">
                <a class="nav-icon-link" asp-controller="Settings" asp-action="Index" aria-label="Configurações">⚙ <span>Configurações</span></a>
                <span class="user-chip"><span class="user-avatar">@User.Identity?.Name?.Substring(0, 1).ToUpper()</span><span>@User.Identity?.Name</span></span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-logout" type="submit">Sair</button></form>
            </div>
        </aside>
        <div class="app-main">
            <div class="app-container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="app-footer">
                <div>
                    <span>© 2026 Saas</span>
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
                        <a asp-controller="Home" asp-action="Terms">Termos</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
