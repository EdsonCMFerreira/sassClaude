<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - sassClaude</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sassClaude.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="app-nav">
            <a class="brand-lockup" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">s</span> sassClaude</a>
            <button class="mobile-nav-toggle" type="button" onclick="document.body.classList.toggle('nav-open')" aria-label="Abrir menu">☰</button>
            <div class="app-nav-links">
                <a asp-controller="Dashboard" asp-action="Index">Visão geral</a>
                <a asp-controller="Workspace" asp-action="Index">Workspace</a>
                <a asp-controller="Products" asp-action="Index">Produtos</a>
                <a asp-controller="Clientes" asp-action="Index">Clientes</a>
                <a asp-controller="Fornecedores" asp-action="Index">Fornecedores</a>
                <a asp-controller="Compras" asp-action="Index">Compras</a>
                <a asp-controller="Vendas" asp-action="Index">Vendas</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Login" asp-action="Index">Usuários</a>
                    <a asp-controller="Billing" asp-action="Index">Plano</a>
                    <a asp-controller="Financeiro" asp-action="Index">Financeiro</a>
                    <a asp-controller="AuditLog" asp-action="Index">Auditoria</a>
                }
            </div>
            <div class="app-nav-actions">
                <a class="nav-icon-link" asp-controller="Settings" asp-action="Index" aria-label="Configurações">⚙</a>
                <span class="user-chip"><span class="user-avatar">@User.Identity?.Name?.Substring(0, 1).ToUpper()</span><span>@User.Identity?.Name</span></span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-logout" type="submit">Sair</button></form>
            </div>
        </nav>
    </header>
    <div class="app-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div>
            <span>© 2026 sassClaude</span>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
                <a asp-controller="Home" asp-action="Terms">Termos</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
