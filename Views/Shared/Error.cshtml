@model ErrorViewModel
@{
    ViewData["Title"] = "Erro inesperado";
    Layout = "_MarketingLayout";
}
<div class="empty-state">
    <span class="eyebrow">Erro 500</span>
    <h1>Algo deu errado por aqui.</h1>
    <p class="muted">Nossa equipe já foi notificada. Tente novamente em instantes.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Código de referência: <code>@Model.RequestId</code></p>
    }
    <a class="button button-primary" asp-controller="Home" asp-action="Index">Voltar para o início <span>→</span></a>
</div>
