@model Saas.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Visão geral";
    var ptBr = new System.Globalization.CultureInfo("pt-BR");
}
<div class="page-heading">
    <div><span class="eyebrow">Visão geral</span><h1>Bom trabalho, @User.Identity?.Name.</h1><p class="muted">Aqui está o que está acontecendo no seu workspace hoje.</p></div>
    <a class="button button-primary" asp-controller="Workspace" asp-action="Index">Abrir workspace <span>→</span></a>
</div>
<div class="metric-grid">
    <article class="metric-card metric-highlight"><span class="metric-label">Contas cadastradas</span><strong>@Model.TotalUsers</strong><span class="metric-caption">usuários no workspace</span></article>
    <article class="metric-card"><span class="metric-label">Plano atual</span><strong>Starter</strong><span class="metric-caption">ciclo mensal ativo</span></article>
    <article class="metric-card"><span class="metric-label">Status</span><strong class="status-positive">Ativo</strong><span class="metric-caption">tudo funcionando bem</span></article>
</div>
@if (Model.VendidoEsteMes.HasValue)
{
    <div class="section-heading" style="margin-bottom:14px;">
        <div><span class="eyebrow">Financeiro</span><h2>Resumo do mês</h2><p class="muted">Números reais do seu negócio, atualizados agora.</p></div>
        <a class="text-link" asp-controller="Financeiro" asp-action="Index">Ver financeiro completo <span>→</span></a>
    </div>
    <div class="metric-grid" style="margin-bottom:18px;">
        <article class="metric-card metric-highlight"><span class="metric-label">Vendido este mês</span><strong>@Model.VendidoEsteMes.Value.ToString("C", ptBr)</strong><span class="metric-caption">pedidos concluídos</span></article>
        <article class="metric-card"><span class="metric-label">A receber</span><strong>@Model.AReceber!.Value.ToString("C", ptBr)</strong><span class="metric-caption">em aberto, de clientes</span></article>
        <article class="metric-card"><span class="metric-label">A pagar</span><strong>@Model.APagar!.Value.ToString("C", ptBr)</strong><span class="metric-caption">em aberto, a fornecedores</span></article>
    </div>
}
<div class="surface-card activity-card" style="margin-bottom:18px;">
    <div class="section-heading"><div><span class="eyebrow">Atenção</span><h2>Central de alertas</h2><p class="muted">Itens que valem uma olhada — vencimentos, estoque e contas em aberto.</p></div></div>
    @if (!Model.Alertas.Any())
    {
        <p class="muted" style="padding:0 27px 27px;">Tudo em dia — nenhum alerta no momento.</p>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:10px;padding:0 27px 27px;">
            @foreach (var alerta in Model.Alertas)
            {
                <a href="@alerta.Url" class="settings-row" style="border:1px solid var(--line);border-radius:12px;padding:14px 16px;text-decoration:none;">
                    <div><span class="status-badge @(alerta.Severidade == "alta" ? "status-badge--cancelada" : "status-badge--devolucao")">@alerta.Categoria</span><p style="margin:8px 0 0;color:var(--ink);">@alerta.Mensagem</p></div>
                    <span class="text-link">Ver <span>→</span></span>
                </a>
            }
        </div>
    }
</div>
<div class="content-grid">
    <section class="surface-card activity-card"><div class="section-heading"><div><span class="eyebrow">Atividade</span><h2>Seu workspace está pronto</h2></div><span class="status-dot">Agora</span></div><div class="activity-row"><span class="activity-icon">✓</span><div><strong>Conta configurada</strong><p>Seu acesso foi autenticado com segurança.</p></div><time>Hoje</time></div><div class="activity-row"><span class="activity-icon">＋</span><div><strong>Explore seus usuários</strong><p>Gerencie os acessos pela área de usuários.</p></div><a asp-controller="Login" asp-action="Index">Abrir</a></div></section>
    <aside class="surface-card next-card"><span class="eyebrow">Próximo passo</span><h2>Conheça seu workspace</h2><p>Use o workspace para organizar as informações importantes do seu time.</p><a class="text-link" asp-controller="Workspace" asp-action="Index">Explorar workspace <span>↗</span></a></aside>
</div>
